# Netlify headers (GitHub Pages ignores this file). Netlify already sends "max-age=0, must-revalidate" for everything,
# so a new version shows as soon as it is published; the fonts never change under the same name.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(self), camera=(), microphone=()

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/manifest.webmanifest
  Content-Type: application/manifest+json
